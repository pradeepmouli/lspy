{
  "name": "lspeasy",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript SDK for building Language Server Protocol clients and servers",
  "keywords": [
    "lsp",
    "language-server-protocol",
    "typescript",
    "sdk",
    "language-server",
    "lsp-client",
    "lsp-server"
  ],
  "homepage": "https://pradeepmouli.github.io/lspeasy/",
  "bugs": {
    "url": "https://github.com/pradeepmouli/lspeasy/issues"
  },
  "license": "MIT",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/lspeasy.git"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include=packages/core/src/**/*.ts",
    "test:coverage:all": "vitest run --config vitest.coverage-all.config.ts --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest run e2e",
    "test:unit": "vitest run packages",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "type-check": "pnpm -r run type-check",
    "typecheck:watch": "pnpm -r --parallel run type-check -- --watch",
    "clean": "pnpm -r run clean && rm -rf node_modules/.cache",
    "clean:all": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "fresh": "pnpm clean:all && pnpm install",
    "dev": "pnpm -r --parallel run dev",
    "audit": "pnpm audit --audit-level moderate",
    "outdated": "pnpm outdated -r",
    "update:deps": "pnpm update -r --latest",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish",
    "fetch:metamodel": "tsx scripts/fetch-metamodel.ts --force",
    "generate:protocol": "tsx scripts/generate-protocol-types.ts && oxfmt packages/core/src/protocol/*.ts && pnpm --filter @lspeasy/core run build && tsx scripts/generate-cli-descriptors.ts && oxfmt apps/cli/src/generated/*.ts",
    "update:protocol": "pnpm run fetch:metamodel && pnpm run generate:protocol",
    "prepare": "simple-git-hooks",
    "docs:dev": "pnpm --filter @lspeasy/docs dev",
    "docs:build": "pnpm --filter @lspeasy/docs build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@lspeasy/core": "workspace:*",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "camelcase": "^9.0.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "simple-git-hooks": "^2.14.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "x-to-zod": "^0.10.5",
    "zod": "^4.5.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run type-check"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.3"
}

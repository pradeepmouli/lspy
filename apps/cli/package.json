{
  "name": "@lsproxy/cli",
  "version": "1.1.0",
  "description": "Standalone refactor CLI driving any LSP server: project-wide rename, file-move with importer updates, and code actions.",
  "private": false,
  "keywords": [
    "lsp",
    "language-server-protocol",
    "refactor",
    "rename",
    "codemod",
    "cli",
    "typescript"
  ],
  "homepage": "https://github.com/pradeepmouli/lspeasy#readme",
  "bugs": {
    "url": "https://github.com/pradeepmouli/lspeasy/issues"
  },
  "license": "MIT",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/lspeasy.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "lsproxy": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "skills",
    "skillit-postinstall.cjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc --build --watch",
    "type-check": "tsc --noEmit",
    "postinstall": "node ./skillit-postinstall.cjs",
    "skill:gen": "tsx scripts/gen-skill.ts"
  },
  "dependencies": {
    "@lspeasy/client": "workspace:*",
    "@lspeasy/core": "workspace:*",
    "@lsproxy/proxy": "workspace:*",
    "commander": "^15.0.0",
    "smol-toml": "^1.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@lspeasy/server": "workspace:*",
    "@skillit/cli": "^1.1.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
